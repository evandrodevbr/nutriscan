# Banco de dados SQLite usado pelo Prisma.
# O caminho é relativo à pasta prisma/ (onde fica o schema), então este valor
# aponta para prisma/prisma/db/database.sqlite.
DATABASE_URL="file:./prisma/db/database.sqlite"

# Opcional. Quando "true", a aplicação responde apenas com o cache local
# (data/products-cache.json) e não chama a API do Open Food Facts.
# NEXT_PUBLIC_CACHE_ONLY_MODE="false"

# Opcional. Origem do proxy de analytics (Rybbit) configurado em next.config.mjs.
# Padrão quando vazio: https://analytics.evandro.dev.br/api
# NEXT_PUBLIC_RYBBIT_HOST="https://analytics.evandro.dev.br/api"
